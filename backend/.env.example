PORT=3000
# Used by docker-compose.yml to create the database (published on host port 5433).
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_db_name
# Must use the same user, password and database name as the three values above.
DATABASE_URL=postgres://your_username:your_password@localhost:5433/your_db_name

# The owner frontend; the API only accepts browser requests from here.
CORS_ORIGIN=http://localhost:5173

# Optional. Tests use DATABASE_URL + "_test" (e.g. myapp_test) unless this is set.
# The test database is wiped before every test, so its name must end with "_test".
# TEST_DATABASE_URL=postgres://your_username:your_password@localhost:5433/your_db_name_test
